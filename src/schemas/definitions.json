{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "date_time_with_offset": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000000
        },
        "document_number": {
            "type": "string",
            "pattern": "^([0-9]{3}\\.?[0-9]{3}\\.?[0-9]{3}-?[0-9]{2}|[0-9A-Z]{2}\\.?[0-9A-Z]{3}\\.?[0-9A-Z]{3}/?[0-9A-Z]{4}-?[0-9]{2})$"
        },
        "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_number"],
            "properties": {
                "document_number": {"$ref": "#/definitions/document_number"}
            }
        },
        "branch": {
            "type": "string",
            "pattern": "^[0-9]{1,10}$"
        },
        "account_number": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
        },
        "participant": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
        }
    }
}
