{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "level": {
            "type": "string",
            "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        },
        "event": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{0,49}$"
        },
        "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "since": {"$ref": "definitions.json#/definitions/date_time_with_offset"},
        "limit": {
            "type": "string",
            "pattern": "^([1-9][0-9]?|1[0-9]{2}|200)$"
        }
    }
}
