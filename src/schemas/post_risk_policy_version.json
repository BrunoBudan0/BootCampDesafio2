{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["change_reason"],
    "properties": {
        "change_reason": {
            "type": "string",
            "maxLength": 255,
            "pattern": "\\S"
        },
        "based_on_template": {
            "type": "string",
            "enum": ["conservative", "balanced", "permissive"]
        },
        "parameters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "history_window_days": {"type": "integer", "minimum": 1, "maximum": 3650},
                "source_history_weight": {"type": "integer", "minimum": 1, "maximum": 1000},
                "population_median_weight": {"type": "integer", "minimum": 1, "maximum": 1000},
                "reference_average_ticket_individual_to_individual_cents": {"$ref": "definitions.json#/definitions/amount_cents"},
                "reference_average_ticket_individual_to_company_cents": {"$ref": "definitions.json#/definitions/amount_cents"},
                "reference_average_ticket_company_to_individual_cents": {"$ref": "definitions.json#/definitions/amount_cents"},
                "reference_average_ticket_company_to_company_cents": {"$ref": "definitions.json#/definitions/amount_cents"},
                "amount_rules_floor_cents": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
                "new_account_age_days": {"type": "integer", "minimum": 1, "maximum": 3650},
                "new_account_cap_individual_cents": {"$ref": "definitions.json#/definitions/amount_cents"},
                "new_account_cap_company_cents": {"$ref": "definitions.json#/definitions/amount_cents"},
                "identity_family_cap": {"type": "integer", "minimum": 1, "maximum": 1000},
                "velocity_family_cap": {"type": "integer", "minimum": 1, "maximum": 1000},
                "amount_family_cap": {"type": "integer", "minimum": 1, "maximum": 1000},
                "counterparty_family_cap": {"type": "integer", "minimum": 1, "maximum": 1000},
                "counterparty_relationship_cap": {"type": "integer", "minimum": 1, "maximum": 1000},
                "behavior_score_cap": {"type": "integer", "minimum": 1, "maximum": 1000},
                "two_factor_score_threshold": {"type": "integer", "minimum": 1, "maximum": 1000},
                "rejection_score_threshold": {"type": "integer", "minimum": 1, "maximum": 1000},
                "two_factor_validity_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
                "destination_alert_threshold": {"type": "integer", "minimum": 1, "maximum": 1000},
                "short_term_window_minutes": {"type": "integer", "minimum": 1, "maximum": 43200}
            }
        },
        "rules": {
            "type": "array",
            "maxItems": 50,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code"],
                "minProperties": 2,
                "properties": {
                    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"},
                    "enabled": {"type": "boolean"},
                    "points": {"type": "integer", "minimum": -100, "maximum": 100},
                    "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 9999999999.99},
                    "window_minutes": {"type": "integer", "minimum": 1, "maximum": 525600},
                    "company_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 9999999999.99}
                }
            }
        }
    }
}
